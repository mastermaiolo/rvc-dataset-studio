{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rvc-dataset-studio.local/schema/bank.schema.json",
  "title": "Core exercise bank",
  "description": "Language-independent exercises (vowels, sirens, scales, dynamics).",
  "type": "object",
  "required": ["id", "version", "exercises"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "core" },
    "version": { "type": "integer", "minimum": 2 },
    "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "exercise.schema.json" } }
  },
  "additionalProperties": false
}
