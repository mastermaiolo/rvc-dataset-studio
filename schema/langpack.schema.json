{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rvc-dataset-studio.local/schema/langpack.schema.json",
  "title": "Language pack",
  "description": "Speech, articulation, phoneme and sung-phrase exercises for one spoken language.",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "script",
    "exercises"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "name": {
      "$ref": "exercise.schema.json#/$defs/ltext"
    },
    "script": {
      "enum": [
        "latin",
        "hanzi",
        "cyrillic",
        "arabic",
        "devanagari",
        "kana",
        "hangul",
        "greek",
        "hebrew",
        "other"
      ]
    },
    "romanization": {
      "type": "string"
    },
    "voiceTest": {
      "type": "object",
      "properties": {
        "speech": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "speech"
      ],
      "additionalProperties": false
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "exercise.schema.json"
      }
    },
    "tips": {
      "description": "Pack-specific coaching tips, keyed by the `tip` name exercises use. Checked before the app's built-in tips.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]+$"
      },
      "additionalProperties": {
        "$ref": "exercise.schema.json#/$defs/ltext"
      }
    }
  },
  "additionalProperties": false
}
