{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rvc-dataset-studio.local/schema/exercise.schema.json",
  "title": "Exercise",
  "description": "One recordable exercise. Pitches are relative to the singer's comfortable range: `pos` places the first note (0 = lowest comfortable note, 1 = highest; values slightly outside are allowed for light touches), and intervals are semitones from that first note. Display strings are localized objects keyed by BCP-47 locale (e.g. {\"en\": \"Calm\", \"pt-BR\": \"Calmo\"}).",
  "type": "object",
  "$defs": {
    "ltext": {
      "description": "Localized display text.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Z]{2}|-[A-Z][a-z]{3})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "tone": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        "h"
      ]
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "cat",
        "mode",
        "dur",
        "tip"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "cat": {
          "enum": [
            "vowels",
            "glides",
            "speech",
            "phonemes",
            "dynamics"
          ]
        },
        "mode": {
          "enum": [
            "sustain",
            "glide",
            "melody",
            "speech",
            "drill",
            "tones"
          ]
        },
        "dur": {
          "type": "number",
          "minimum": 2,
          "maximum": 20
        },
        "tip": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "rg": {
          "type": "string",
          "enum": [
            "chest",
            "mixed",
            "falsetto",
            "speech"
          ]
        },
        "reg": {
          "$ref": "#/$defs/ltext"
        },
        "emo": {
          "$ref": "#/$defs/ltext"
        },
        "sub": {
          "$ref": "#/$defs/ltext"
        },
        "title": {
          "$ref": "#/$defs/ltext"
        }
      }
    },
    "pos": {
      "description": "Position of the first note inside the comfortable range: 0 = lowest, 1 = highest.",
      "type": "number",
      "minimum": -0.3,
      "maximum": 1.3
    },
    "interval": {
      "description": "Semitones relative to the first note.",
      "type": "integer",
      "minimum": -24,
      "maximum": 24
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base"
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "sustain"
        },
        "pos": {
          "$ref": "#/$defs/pos"
        },
        "pre": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}$"
        },
        "vowel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "pos",
        "vowel"
      ]
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "sustain"
        },
        "pos": {
          "$ref": "#/$defs/pos"
        },
        "vowels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "pos",
        "vowels"
      ]
    },
    {
      "type": "object",
      "description": "Siren by intervals (e.g. an octave) from pos.",
      "properties": {
        "mode": {
          "const": "glide"
        },
        "vowel": {
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "$ref": "#/$defs/pos"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/interval"
          }
        }
      },
      "required": [
        "vowel",
        "pos",
        "steps"
      ]
    },
    {
      "type": "object",
      "description": "Siren through positions of the range (e.g. [0, 1, 0] = bottom → top → bottom), scales with the singer.",
      "properties": {
        "mode": {
          "const": "glide"
        },
        "vowel": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/pos"
          }
        }
      },
      "required": [
        "vowel",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "melody"
        },
        "pos": {
          "$ref": "#/$defs/pos"
        },
        "highlight": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/interval"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 3
          }
        }
      },
      "required": [
        "pos",
        "notes"
      ]
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "speech",
            "drill"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 2
        }
      },
      "required": [
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "tones"
        },
        "syl": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 2
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/tone"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            ]
          }
        }
      },
      "required": [
        "syl"
      ]
    }
  ],
  "unevaluatedProperties": false
}
