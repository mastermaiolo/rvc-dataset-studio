      "emo": {"en": "Narrative", "pt-BR": "Narrativa"},
      "tip": "speech",
      "sub": {"en": "Descriptive, vivid images", "pt-BR": "Descritivo, imagens nítidas"},
      "reg": {"en": "Speech · Middle", "pt-BR": "Fala · Médio"}
    },
    {
      "id": "sp-do-you-want-the",
      "cat": "speech",
      "mode": "speech",
      "text": "Do you want the red guitar, or would you rather keep the blue one? You can’t take both home tonight.",
